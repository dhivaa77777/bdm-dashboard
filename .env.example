# Olist Customer & Payment Analytics Dashboard
# Copy this file to .env and fill in real values. NEVER commit .env.

# Direct PostgreSQL connection string for the Supabase database.
# Get it from: Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Format:
SUPABASE_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Optional (supabase-py, only needed if you switch the loader to the REST client)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=your-anon-key